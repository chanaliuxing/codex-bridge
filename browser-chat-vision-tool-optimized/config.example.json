      "preprocess": [
        "gray",
        "edge"
      ]
    },
    "copy_button": {
      "path": "templates/copy_button.png",
      "threshold": 0.86,
      "roi": "whole",
      "preprocess": [
        "gray",
        "edge"
      ]
    },
    "down_arrow": {
      "path": "templates/down_arrow.png",
      "threshold": 0.86,
      "roi": "center_lower",
      "preprocess": [
        "gray",
        "edge"
      ]
    }
  },
  "logic": {
    "page_markers": [
      "page_chatgpt",
      "mode_thinking",
      "mode_extended_thinking"
    ],
    "input_markers": [
      "typebox",
      "input_box"
    ],
    "voice_markers": [
      "voice_button"
    ],
    "send_markers": [
      "send_button"
    ],
    "waiting_markers": [
      "stop_button",
      "stop_button_with_mic"
    ],
    "reply_markers": [
      "copy_button"
    ],
    "down_arrow_markers": [
      "down_arrow"
    ],
    "down_arrow_max_clicks": 3
  }
